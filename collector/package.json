{
    "name": "pulsedb-collector",
    "version": "0.1.0",
    "description": "PulseDB managed monitoring agent — samples wait events and query stats from Postgres and ships them to your PulseDB instance.",
    "type": "module",
    "bin": {
        "pulsedb-collector": "./pulsedb-collector.mjs",
        "pulsedb-autoexplain-shipper": "./pulsedb-autoexplain-shipper.mjs"
    },
    "scripts": {
        "start": "node pulsedb-collector.mjs",
        "start:autoexplain": "node pulsedb-autoexplain-shipper.mjs"
    },
    "dependencies": {
        "pg": "^8.18.0",
        "@aws-sdk/client-cloudwatch-logs": "^3.600.0"
    },
    "engines": {
        "node": ">=20"
    }
}
