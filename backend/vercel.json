{
    "version": 2,
    "installCommand": "npm ci",
    "builds": [
        {
            "src": "server.ts",
            "use": "@vercel/node",
            "config": {
                "maxDuration": 30,
                "memory": 1024
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "server.ts"
        }
    ]
}
