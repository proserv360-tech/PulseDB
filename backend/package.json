{
    "name": "pulsedb-backend",
    "version": "1.0.0",
    "type": "module",
    "description": "PulseDB — Universal Database Monitoring & Administration Backend",
    "main": "server.ts",
    "_note_optionalDependencies": "Phase-5 engine peer drivers. Each adapter in services/dbAdapters/ uses dynamic import() with graceful fallback, so these are OPTIONAL — npm install will still succeed on platforms where one of them can't build (e.g. oracledb needs the Oracle Instant Client). Only the drivers for engines you actually connect to need to be present at runtime.",
    "scripts": {
        "start": "tsx server.ts",
        "dev": "nodemon --exec tsx server.ts",
        "build": "tsc",
        "type-check": "tsc --noEmit",
        "test": "tsx --test tests/*.test.ts",
        "migrate": "tsx scripts/migrate.ts",
        "sql": "tsx scripts/run-sql.ts",
        "slack:add": "tsx scripts/add-slack-destination.ts",
        "slack:probe": "tsx scripts/probe-slack-interaction.ts",
        "slack:webhook": "tsx scripts/update-slack-webhook.ts",
        "report:silent": "tsx scripts/report-silent-failures.ts",
        "migrate:enterprise": "tsx scripts/migrate-enterprise.ts",
        "doctor": "tsx scripts/doctor.ts",
        "alert:test": "tsx scripts/test-alert.ts",
        "alert:clean": "tsx scripts/delete-test-alerts.ts",
        "worker": "tsx worker.ts",
        "dev:worker": "nodemon --exec tsx worker.ts",
        "test:integration": "tsx --test --test-force-exit tests/integration/*.int.test.ts",
        "test:coverage": "c8 --reporter=text --reporter=lcov --include 'services/**' --include 'middleware/**' --include 'routes/**' tsx --test tests/*.test.ts",
        "seed:demo": "tsx scripts/seed-demo-users.ts"
    },
    "dependencies": {
        "@aws-sdk/client-cloudwatch": "^3.998.0",
        "@node-saml/node-saml": "^5.0.0",
        "@prisma/client": "^7.8.0",
        "@sentry/node": "^10.57.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.2.4",
        "drizzle-orm": "^0.45.1",
        "express": "^5.2.1",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^6.12.0",
        "mysql2": "^3.11.0",
        "node-cron": "^4.2.1",
        "nodemailer": "^9.0.3",
        "pg": "^8.18.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "prisma": "^7.8.0",
        "tsx": "^4.19.0",
        "uuid": "^14.0.0",
        "ws": "^8.21.1",
        "zod": "^3.24.0"
    },
    "optionalDependencies": {
        "@aws-sdk/client-dynamodb": "^3.998.0",
        "@aws-sdk/client-s3": "^3.998.0",
        "@aws-sdk/client-kms": "^3.998.0",
        "@elastic/elasticsearch": "^9.5.1",
        "@google-cloud/bigquery": "^8.1.1",
        "bullmq": "^5.16.0",
        "cassandra-driver": "^4.7.2",
        "ioredis": "^5.4.2",
        "mssql": "^11.0.1",
        "oracledb": "^6.6.0",
        "snowflake-sdk": "^1.1.7"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.10.0",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^6.4.17",
        "@types/pg": "^8.11.10",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.5.13",
        "c8": "^10.1.0",
        "drizzle-kit": "^0.31.10",
        "nodemon": "^3.1.11",
        "supertest": "^7.0.0",
        "typescript": "^5.7.0"
    }
}
