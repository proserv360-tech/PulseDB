backend/scripts/dump-neon.bat
backend/scripts/restore-supabase.bat
backend/scripts/verify-migration.bat
backend/scripts/*.dump
*.dump

# Migration credential scripts + DB dumps — NEVER commit (added after Neon→Supabase migration)
backend/scripts/*.bat
backend/scripts/*.dump
*.dump

# Local DB backup dump (real user data) — never commit
supabase_backup_tool_monitoring/

