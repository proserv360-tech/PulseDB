# Node - Dependencies
**/node_modules/
**/dist/
**/build/

# Environment Variables — NEVER commit real .env files
.env
.env.*
.env.local
.env.production
**/.env
**/.env.*
**/.env.local
**/.env.production.*
frontend/.env*
backend/.env
backend/.env.*
# ...but templates with no real values must stay tracked
!.env.example
!**/.env.example

# Migration scripts with hardcoded credentials
backend/neon-migrate.mjs

