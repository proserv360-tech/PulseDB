# ─────────────────────────────────────────────────────────────────────────────
# FATHOM — Root Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# API base URL — points to the FATHOM backend on Railway
# Local dev: http://localhost:5000
# Production: https://your-backend.up.railway.app
VITE_API_URL=http://localhost:5000

# ── Optional: AI Features ──────────────────────────────────────────────────
# VITE_GROQ_API_KEY=gsk_your_key_here

# ── Distributed state (Wave A task A1) ─────────────────────────────────────
# Redis URL shared by the web tier and (in B1) the worker tier.
# Used for:
#   • Distributed rate-limit token bucket (middleware/rateLimiter.js)
#   • BullMQ queues (forthcoming)
#   • Cron leader election (forthcoming)
# Local dev: redis://localhost:6379
# Production: managed Redis (Upstash, Elasticache, Railway Pro, etc.)
# If unset, the rate limiter falls back to in-memory per-process buckets.
# REDIS_URL=redis://localhost:6379

# Controls who can use "Try the live demo".
#   DEMO_ALLOWLIST=*                          -> allow ANY user (open demo)
#   DEMO_ALLOWLIST=alice@acme.com, @yourco.com -> only these emails / domains
#   (unset)                                   -> deny everyone (fail closed)
DEMO_ALLOWLIST=
